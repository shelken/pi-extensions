{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "packageRules": [
    {
      "description": "忽略子包的 peerDependencies，由宿主环境决定",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "typebox 锁宿主自带版本，不由 Renovate 升级；与宿主是否一致由 scripts/host-typebox.node-test.mjs 校验",
      "matchPackageNames": ["typebox"],
      "enabled": false
    },
    {
      "description": "node 在 .mise.toml 里保持 \"24\"（mise 安装最新 24.x），否则 Renovate 会把它改写成精确版本；只有新 major 才提 PR",
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "description": "基础设施的非 major 更新合并为一个 PR 并自动合并：Actions、mise 工具链（bun/gitleaks）",
      "matchManagers": ["github-actions", "mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "基础设施",
      "groupSlug": "infra",
      "automerge": true
    },
    {
      "description": "基础设施的非 major 更新：开发依赖（tsc/vitest/oxlint/changesets，含 pi-core 宿主依赖）",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "基础设施",
      "groupSlug": "infra",
      "automerge": true
    },
    {
      "description": "会发布到 npm 的 runtime 生产依赖：非 major 自动合并，发布由 chore(release) PR 人工把关",
      "matchDepTypes": ["dependencies"],
      "matchFileNames": ["extensions/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "插件 runtime 依赖",
      "groupSlug": "runtime",
      "automerge": true
    }
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Shanghai",
  "prHourlyLimit": 5,
  "rangeStrategy": "bump",
  "gitIgnoredAuthors": [
    "github-actions[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com"
  ]
}
