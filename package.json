{
  "name": "@shelken/pi-extensions",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "keywords": [
    "pi-package",
    "pi",
    "extensions"
  ],
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test scripts/*.node-test.mjs && bun --filter '*' test && vitest run",
    "verify": "bun run check && bun run test",
    "deps:update": "bun update --latest --recursive && bun run verify",
    "deps:update:dry": "bun update --latest --recursive --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-auto-model-prompts/src/index.ts",
      "./extensions/pi-dynamic-models/src/index.ts",
      "./extensions/pi-guard/src/index.ts",
      "./extensions/pi-inline-skills/src/index.ts",
      "./extensions/pi-co-authored-by/src/index.ts",
      "./extensions/pi-command-history/src/index.ts",
      "-./extensions/pi-add-dir/src/index.ts",
      "-./extensions/pi-title/src/index.ts",
      "./extensions/simple-plannotator/src/index.ts",
      "./extensions/copy-cut/src/index.ts"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "26.6.5",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
